# ember VM developer image: Ubuntu 26.04 with systemd, sshd, serial console,
# and a full developer toolchain (Rust, Go, Claude Code, gh, etc.).
#
# Built with:  ember image build ubuntu-dev -f images/Dockerfile.ubuntu-dev
# Or manually:  docker build -t ember-ubuntu-dev -f images/Dockerfile.ubuntu-dev images/
#
# Designed to run as a Firecracker microVM root filesystem with a proper
# init system.  systemd handles process supervision, graceful shutdown
# (CtrlAltDel), and service management (sshd, serial console getty).
#
# The primary user is `ubuntu` (uid 1000) with passwordless sudo.
# SSH connects as ubuntu by default; root is available via `sudo`.

FROM ubuntu:resolute-20251101

ENV DEBIAN_FRONTEND=noninteractive

# ---------- unminimize (restore man pages, docs, locales) ----------
# Must come before other apt installs so their docs are retained.
RUN apt-get update \
    && apt-get install -y unminimize \
    && yes | unminimize \
    && rm -rf /var/lib/apt/lists/*

# ---------- all apt packages in one layer ----------
# Bootstrap curl, add third-party repos (GitHub CLI, Docker), then install
# everything with a single apt-get update and cleanup cycle.
# Core system + Docker use --no-install-recommends; dev tools don't (we want
# man pages and bash completions).
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl \
    # GitHub CLI repo
    && curl -fsSL https://cli.github.com/packages/githubcli-archive-keyring.gpg \
        | dd of=/usr/share/keyrings/githubcli-archive-keyring.gpg \
    && echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" \
        > /etc/apt/sources.list.d/github-cli.list \
    # Docker repo (uses noble/24.04 — Docker doesn't publish resolute/26.04 packages yet)
    && install -m 0755 -d /etc/apt/keyrings \
    && curl -fsSL https://download.docker.com/linux/ubuntu/gpg -o /etc/apt/keyrings/docker.asc \
    && chmod a+r /etc/apt/keyrings/docker.asc \
    && echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.asc] https://download.docker.com/linux/ubuntu noble stable" \
         > /etc/apt/sources.list.d/docker.list \
    # Re-fetch with third-party repos included
    && apt-get update \
    # Core system (minimal)
    && apt-get install -y --no-install-recommends \
        systemd \
        systemd-sysv \
        dbus \
        libpam-systemd \
        openssh-server \
        iproute2 \
        iputils-ping \
        wget \
        sudo \
        docker-ce \
        docker-ce-cli \
        containerd.io \
        docker-buildx-plugin \
        docker-compose-plugin \
    # Dev tools (with recommends for man pages & bash completions)
    && apt-get install -y \
        git \
        build-essential \
        cmake \
        libclang-dev \
        llvm \
        python3 \
        jq \
        neovim \
        stow \
        tmux \
        less \
        htop \
        file \
        unzip \
        ncdu \
        tig \
        man-db \
        bash-completion \
        locales \
        golang-go \
        gh \
    && rm -rf /var/lib/apt/lists/*

# ---------- locale ----------
RUN sed -i 's/# en_US.UTF-8/en_US.UTF-8/' /etc/locale.gen && locale-gen \
    && echo 'LANG=en_US.UTF-8' > /etc/default/locale \
    && echo 'LC_ALL=en_US.UTF-8' >> /etc/default/locale
ENV LANG=en_US.UTF-8
ENV LC_ALL=en_US.UTF-8

# ---------- ubuntu user with passwordless sudo ----------
# The ubuntu base image may already include an `ubuntu` user;
# create it only if missing, then ensure group membership and home dir.
RUN id -u ubuntu &>/dev/null || useradd -m -s /bin/bash ubuntu; \
    usermod -aG sudo,docker -s /bin/bash ubuntu \
    && install -d -o ubuntu -g ubuntu /home/ubuntu \
    && echo 'ubuntu ALL=(ALL) NOPASSWD:ALL' > /etc/sudoers.d/ubuntu \
    && chmod 0440 /etc/sudoers.d/ubuntu

# ---------- unprivileged ICMP (ping, traceroute, mtr) ----------
# Allow all users to create ICMP sockets without cap_net_raw.
# Applied at boot by systemd-sysctl.
RUN echo 'net.ipv4.ping_group_range = 0 2147483647' > /etc/sysctl.d/50-ping.conf

# ---------- Buildkite CLI (bk) ----------
ARG TARGETARCH
ARG BK_VERSION=3.31.1
RUN curl -fsSL "https://github.com/buildkite/cli/releases/download/v${BK_VERSION}/bk_${BK_VERSION}_linux_${TARGETARCH}.deb" -o /tmp/bk.deb \
    && dpkg -i /tmp/bk.deb \
    && rm /tmp/bk.deb

# ---------- enable services ----------
# Firecracker uses ttyS0; macOS AVF uses hvc0 (virtio-console).
# Enable both — the unused one simply won't start.
RUN systemctl enable docker \
    && systemctl enable ssh.socket \
    && systemctl enable serial-getty@ttyS0.service \
    && systemctl enable serial-getty@hvc0.service ends

# ---------- per-user tools (installed as ubuntu) ----------
USER ubuntu
WORKDIR /home/ubuntu

# Rust
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y
ENV PATH="/home/ubuntu/.cargo/bin:${PATH}"

# uv (Python package manager, replaces pip/venv)
RUN curl -LsSf https://astral.sh/uv/install.sh | sh
ENV PATH="/home/ubuntu/.local/bin:${PATH}"

# Claude Code
RUN curl -fsSL https://claude.ai/install.sh | bash

USER root

# ---------- PATH for SSH sessions ----------
# /etc/environment is read by PAM on SSH login, covering non-interactive
# SSH commands as well as interactive sessions.
RUN echo 'PATH="/home/ubuntu/.local/bin:/home/ubuntu/.cargo/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"' > /etc/environment

# ---------- SSH ----------
RUN mkdir -p /run/sshd \
    && sed -i 's/#PermitRootLogin.*/PermitRootLogin prohibit-password/' /etc/ssh/sshd_config \
    && sed -i 's/#PubkeyAuthentication.*/PubkeyAuthentication yes/' /etc/ssh/sshd_config

# ---------- strip systemd units that are useless / harmful in a VM ----------
RUN rm -f /etc/systemd/system/getty.target.wants/getty@tty1.service  || true
# We inject our own /etc/resolv.conf; don't let resolved overwrite it.
RUN systemctl disable systemd-resolved.service 2>/dev/null || true
# networkd would fight the kernel ip= boot-arg networking.
RUN systemctl disable systemd-networkd.service 2>/dev/null || true

# ---------- root password (fallback for serial console; SSH uses keys) ----------
RUN echo 'root:ember' | chpasswd

# ---------- refresh apt package index ----------
# Earlier layers remove /var/lib/apt/lists/* to shrink Docker layers, but
# this is a VM image — users expect `apt install` to work out of the box.
RUN apt-get update

CMD ["/sbin/init"]
